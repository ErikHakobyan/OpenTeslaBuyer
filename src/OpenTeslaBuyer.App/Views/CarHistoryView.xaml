<UserControl x:Class="OpenTeslaBuyer.App.Views.CarHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenTeslaBuyer.App">
    <DockPanel Margin="10,16,16,10">
        <StackPanel DockPanel.Dock="Top" Margin="6,0,6,10">
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Car history" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding Summary}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cars -->
            <Border Style="{StaticResource Card}" Padding="6">
                <ListBox ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCar}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Text="{Binding Vin}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Selected car -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Delete car" Command="{Binding DeleteCarCommand}"
                                    ToolTip="Remove this car's saved checks and alert history (recording files are kept)" />
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedCar.Title}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding SelectedCar.Vin}" />
                                    <Button Margin="4,0,0,0" Style="{StaticResource IconButton}" ToolTip="Copy VIN" Command="{Binding CopyVinCommand}" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding SelectedCar.Meta}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding ChoiceText}"
                                           Visibility="{Binding ChoiceText, Converter={StaticResource CollapsedWhenEmpty}}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Text="{Binding Feedback}" Visibility="{Binding Feedback, Converter={StaticResource CollapsedWhenEmpty}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Battery health over time" />
                            <local:TrendChart Height="150" Values="{Binding HealthPoints}"
                                              LineBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                              TextBrush="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding HealthTrend}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Saved checks" />
                            <ItemsControl ItemsSource="{Binding Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Open report"
                                                    Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                    <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Health, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Alert history" />
                            <TextBlock Style="{StaticResource Caption}" Text="Alerts this tool has recorded for this car, across all sessions." />
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding AlertsNote}"
                                       Visibility="{Binding AlertsNote, Converter={StaticResource CollapsedWhenEmpty}}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Code, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Recordings" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding RecordingsNote}"
                                       Visibility="{Binding RecordingsNote, Converter={StaticResource CollapsedWhenEmpty}}" />
                            <ItemsControl ItemsSource="{Binding Recordings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Replay" IsEnabled="{Binding Exists}"
                                                    Command="{Binding DataContext.ReplayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Meta}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Notes" />
                            <TextBox MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="Anything worth remembering about this car: price, seller, service history." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
