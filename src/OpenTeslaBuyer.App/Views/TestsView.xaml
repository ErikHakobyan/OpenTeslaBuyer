<UserControl x:Class="OpenTeslaBuyer.App.Views.TestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenTeslaBuyer.App.Views">
    <DockPanel Margin="10,16,16,10">
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Go to Diagnostics" Style="{DynamicResource AccentButtonStyle}"
                    Command="{Binding GoToDiagnosticsCommand}" Visibility="{Binding IsConnected, Converter={StaticResource VisibleWhenFalse}}"
                    ToolTip="Connect there; the tests follow the connection" />
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Tests" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                           Text="Checks that run with the car parked, in the background while connected, whichever page is open. The tool only listens; nothing is sent to the car." />
            </StackPanel>
        </DockPanel>

        <TabControl Margin="6,0,6,0" Background="Transparent" BorderThickness="0">
            <TabItem Header="Charging test">
                <views:ChargingView DataContext="{Binding Charging}" />
            </TabItem>
            <TabItem Header="Overnight test">
                <views:OvernightView DataContext="{Binding Overnight}" />
            </TabItem>
            <TabItem Header="Charger">
                <views:ChargerView DataContext="{Binding Charger}" />
            </TabItem>
            <TabItem Header="12 V">
                <views:TwelveVoltView DataContext="{Binding TwelveVolt}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
