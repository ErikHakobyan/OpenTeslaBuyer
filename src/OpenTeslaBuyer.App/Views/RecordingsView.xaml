<UserControl x:Class="OpenTeslaBuyer.App.Views.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10,16,16,10">
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Margin="0,0,8,0" Content="Add recordings…" Command="{Binding ImportCommand}"
                        ToolTip="Add candump log files from another folder or tool to this list" />
                <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Recordings" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding Summary}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,2,0,0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE7C8;" />
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                             Text="{Binding FileName, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Car}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding Meta}" />
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Notes" />
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" Content="Replay" IsEnabled="{Binding Exists}"
                                            ToolTip="Play this recording on the Diagnostics page"
                                            Command="{Binding DataContext.ReplayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Margin="0,0,8,0" Content="Show in folder"
                                            Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
