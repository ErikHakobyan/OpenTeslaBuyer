<UserControl x:Class="OpenTeslaBuyer.App.Views.ChargingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Status dot: resting = accent, charging = green, discharging = amber. -->
        <Style x:Key="ActivityDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActivityKind}" Value="resting">
                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActivityKind}" Value="charging">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActivityKind}" Value="discharging">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultAccent" TargetType="Border">
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="Padding" Value="12,2,0,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultKind}" Value="ok">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultKind}" Value="attention">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultKind}" Value="critical">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="BarPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <!-- Voltages now, one colour; groups the result flagged keep their colour here too. -->
        <DataTemplate x:Key="VoltageBar">
            <Grid Background="Transparent" ToolTip="{Binding ToolTip}">
                <Border Height="{Binding Height}" Margin="1,0" VerticalAlignment="Bottom" CornerRadius="2,2,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="higher">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="much-higher">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResistanceBar">
            <Grid Background="Transparent" ToolTip="{Binding ToolTip}">
                <Border Height="{Binding Height}" Margin="1,0" VerticalAlignment="Bottom" CornerRadius="2,2,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="higher">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="much-higher">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MetricTemplate">
            <StackPanel Margin="0,0,16,12">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" ToolTip="{Binding Hint}" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource Value}" Text="{Binding Value}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="10,16,16,10">
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Margin="0,0,8,0" Content="Go to Diagnostics" Style="{DynamicResource AccentButtonStyle}" Command="{Binding GoToDiagnosticsCommand}"
                        Visibility="{Binding IsConnected, Converter={StaticResource VisibleWhenFalse}}" ToolTip="Connect there; this page follows the connection" />
                <Button Margin="0,0,8,0" Content="Start over" Command="{Binding StartOverCommand}"
                        Visibility="{Binding IsConnected, Converter={StaticResource VisibleWhenTrue}}" ToolTip="Discard this connection's measurements and measure again" />
                <Button Content="Copy result" Command="{Binding CopyResultCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Charging test" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                           Text="Finds weak cell groups by comparing each one at rest and while charging. The car stays parked, and nothing is sent to it." />
                <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Text="{Binding Feedback}" Visibility="{Binding Feedback, Converter={StaticResource CollapsedWhenEmpty}}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Now -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Left" Padding="10,4" CornerRadius="12" VerticalAlignment="Center"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource ActivityDot}" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ActivityText}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock />
                            </DockPanel>
                            <TextBlock FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ProgressText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding EstimateNote}"
                                       Visibility="{Binding EstimateNote, Converter={StaticResource CollapsedWhenEmpty}}" />
                            <ItemsControl Margin="0,14,0,-12" ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource MetricTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- How to run it -->
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="How to run it" />
                            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="1." />
                                <Run Text="Connect on the Diagnostics page with the car parked and awake, not charging. Wait about half a minute." />
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="2." />
                                <Run Text="Start charging and stay connected for about a minute at full charging power." />
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="3." />
                                <Run Text="Optional: stop charging for a minute to add a second measurement." />
                            </TextBlock>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}"
                                       Text="Already charging? Stop for a minute instead. A Supercharger gives the clearest result; home charging is enough to spot a group that clearly stands out." />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Result -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Result" />
                        <Border Style="{StaticResource ResultAccent}">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding ResultTitle}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding ResultDetail}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource VisibleWhenTrue}}">
                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Flagged}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="2,5,10,0" VerticalAlignment="Top">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="critical">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,14,0,0" Style="{StaticResource Caption}"
                                       Text="Resistance of every cell group compared with the typical group. Taller bars rise more under charging current." />
                            <ItemsControl Height="116" Margin="0,10,0,0" ItemsSource="{Binding ResultGroups}"
                                          ItemsPanel="{StaticResource BarPanel}" ItemTemplate="{StaticResource ResistanceBar}" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.6*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" ToolTip="From how much the whole pack's voltage moves with the current; includes busbars and contactors.">
                                    <TextBlock Style="{StaticResource Caption}" Text="Pack resistance (approx.)" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Value}" Text="{Binding PackResistanceText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="Average per cell group" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Value}" Text="{Binding AverageGroupText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="Measurements" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Value}" Text="{Binding MeasurementsText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Style="{StaticResource Caption}" Text="Conditions" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Value}" Text="{Binding ConditionsText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Cell groups right now -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Cell groups right now" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LiveSummary}" />
                        <ItemsControl Height="116" Margin="0,10,0,0" ItemsSource="{Binding LiveGroups}"
                                      ItemsPanel="{StaticResource BarPanel}" ItemTemplate="{StaticResource VoltageBar}"
                                      Visibility="{Binding HasLiveGroups, Converter={StaticResource VisibleWhenTrue}}" />
                    </StackPanel>
                </Border>

                <!-- How it works -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="How it works" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="All cell groups in the pack carry the same current. When charging starts or stops, each group's voltage moves by that current times its internal resistance, so a group with higher resistance moves further than the rest. The test compares every group with the pack's typical group just before and just after the change, which cancels out the state of charge and the temperature. Resistance rises as cells age and when one is damaged." />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}"
                                   Text="Cold packs read higher, so compare tests made at similar temperatures. The tool only listens: it never starts, stops or changes charging." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
