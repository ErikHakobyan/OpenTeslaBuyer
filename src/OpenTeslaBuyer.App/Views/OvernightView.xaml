<UserControl x:Class="OpenTeslaBuyer.App.Views.OvernightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="6,0,6,4" Style="{StaticResource Caption}"
                       Text="Finds a cell group that loses charge faster than the others while the car stands: two parked readings, hours apart, compared group by group." />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Now -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Margin="0,0,0,10" HorizontalAlignment="Left" Padding="10,4" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource ActivityDot}" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ActivityText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding ReadingsText}"
                                   Visibility="{Binding ReadingsText, Converter={StaticResource CollapsedWhenEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- How to run it -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="How to run it" />
                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="1." />
                            <Run Text="In the evening, connect with the car parked (not charging, climate off). After about a minute the tool saves a reading." />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="2." />
                            <Run Text="Leave the car parked overnight, unplugged." />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="3." />
                            <Run Text="In the morning, connect again the same way: the comparison appears here." />
                        </TextBlock>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}"
                                   Text="Any two readings at least 4 hours apart work. Connect after the car has stood for half an hour, so the cells have settled." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Result -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Result" />
                    <Border Style="{StaticResource ResultAccent}">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ResultTitle}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding ResultDetail}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding FlatNote}"
                                       Visibility="{Binding FlatNote, Converter={StaticResource CollapsedWhenEmpty}}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding HasResult, Converter={StaticResource VisibleWhenTrue}}">
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Flagged}" ItemTemplate="{StaticResource FlaggedGroupTemplate}" />
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Caption}"
                                   Text="How much charge every cell group lost compared with the typical group. Taller bars lost more." />
                        <ItemsControl Height="116" Margin="0,10,0,0" ItemsSource="{Binding Bars}"
                                      ItemsPanel="{StaticResource BarPanel}" ItemTemplate="{StaticResource ResistanceBar}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Caption}" Text="Earlier reading" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Value}" Text="{Binding EarlierText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Caption}" Text="This reading" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Value}" Text="{Binding LaterText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Caption}" Text="Apart" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Value}" Text="{Binding ElapsedText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
