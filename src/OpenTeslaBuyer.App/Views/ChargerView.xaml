<UserControl x:Class="OpenTeslaBuyer.App.Views.ChargerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="6,0,6,4" Style="{StaticResource Caption}"
                       Text="Checks the onboard charger while it charges from an AC supply: faults, phases, the current it draws, and how much of the power reaches the battery." />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding PlatformNote}"
                               Visibility="{Binding PlatformNote, Converter={StaticResource CollapsedWhenEmpty}}" />
                    <ItemsControl Margin="0,14,0,-12" ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource MetricTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Findings" />
                    <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource CheckItemTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Why it matters" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="The onboard charger turns AC from the wall into DC for the battery. A failed module in it is a common, costly fault that only shows as slower charging, so it often goes unnoticed until the car is sold. Superchargers feed the battery directly, so they don't test the charger." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
