<UserControl x:Class="OpenTeslaBuyer.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10,16,16,10">
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Search" />
                <TextBox Width="240" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="VIN, model or source"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Reports" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding Summary}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Text="{Binding Feedback}" Visibility="{Binding Feedback, Converter={StaticResource CollapsedWhenEmpty}}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,2,0,0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE8A5;" />
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                             Text="{Binding Car, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Health}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding Meta}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" Content="Open report"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Margin="0,0,8,0" Content="Save as…"
                                            Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Margin="0,0,8,0" Content="Copy summary"
                                            Command="{Binding DataContext.CopySummaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
